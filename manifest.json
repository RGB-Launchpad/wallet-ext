{
  "manifest_version": 3,
  "name": "RGB Wallet",
  "version": "0.12.0",
  "description": "Self-custodial RGB asset wallet. Keys and consignments stay on your device.",
  "permissions": [
    "offscreen",
    "storage",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://mempool.space/*",
    "https://proxy.rgblaunchpad.meme/*",
    "https://regtest-indexer.rgblaunchpad.meme/*",
    "https://regtest-proxy.rgblaunchpad.meme/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RGB Wallet",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "116",
  "content_scripts": [
    {
      "matches": [
        "https://rgblaunchpad.meme/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://rgblaunchpad.meme/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
